	measure 'Units Returned' = SUM(fact_returns[quantity_returned])
		formatString: #,0
		lineageTag: 302d8af6-4e11-484a-b295-1bc03edee1c0

	measure 'Return Rate %' = DIVIDE([Units Returned], [Units Sold])

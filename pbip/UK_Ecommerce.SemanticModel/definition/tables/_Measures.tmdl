table _Measures
	lineageTag: 5a0aa74e-e07a-4c47-8ed9-e935ae17e95e

	measure 'Net Revenue' = ```
			
			    CALCULATE(SUM(fact_order_line[NET_REVENUE]), fact_order_line[IS_CANCELLED] = 0)
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 154741fd-dd41-403d-9af1-4df104c9c88c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Gross Margin' = ```
			
			    CALCULATE(SUM(fact_order_line[gross_margin]), fact_order_line[is_cancelled] = 0)
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 717cb8be-0664-4946-bf51-3045c81d6f55

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Margin %' = DIVIDE([Gross Margin], [Net Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d6a822ab-9d05-404b-a0f1-cf70693c6e93

	measure Orders = ```
			
			    CALCULATE(DISTINCTCOUNT(fact_order_line[ORDER_ID]), fact_order_line[IS_CANCELLED] = 0)
			```
		formatString: #,0
		lineageTag: ee3925c1-bab4-4ee2-a2ab-bfff3e7e4e6c

	measure 'Units Sold' = CALCULATE(SUM(fact_order_line[quantity]), fact_order_line[is_cancelled] = 0)
		formatString: #,0
		lineageTag: a65bffed-0f71-4f88-a3bc-2f387fe0ccb8

	measure AOV = DIVIDE([Net Revenue], [Orders])
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0

/// Field parameter: lets report users switch a visual's breakdown (axis or rows).
table 'Dimension Selector'
	lineageTag: 8ebee76e-e6d7-4d47-b3b8-2a3cdd401abf

	measure selected_dimension_name = ```
			
			VAR _rawText = SELECTEDVALUE ( 'Dimension Selector'[Dimension Selector Fields] )
			VAR _startBracket = SEARCH ( "[", _rawText, 1, 0 )
			VAR _endBracket = SEARCH ( "]", _rawText, 1, 0 )
			RETURN
			    IF ( 
			        _startBracket > 0 && _endBracket > _startBracket,
			        -- Extracts text strictly between the [ and ] brackets
			        MID ( _rawText, _startBracket + 1, _endBracket - _startBracket - 1 ),
			        _rawText -- Fallback if no brackets are found
			    )
			```
		lineageTag: 01e82fb0-598d-4012-89c0-102d18dbe569

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Dimension Selector'
		lineageTag: ab801fb8-0172-4b8f-8eed-8b4133064347
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Dimension Selector Order'

		relatedColumnDetails
			groupByColumn: 'Dimension Selector Fields'

	column 'Dimension Selector Fields'
